# Mẫu biến môi trường. Sao chép thành .env (đã được .gitignore bỏ qua) rồi điền giá trị thật.
# Spring Boot KHÔNG tự đọc file .env: hãy export biến trước khi chạy app, hoặc cấu hình
# trong IDE / Docker. KHÔNG commit file .env.

# ---------------------------------------------------------------------------
# Bắt buộc đổi khi triển khai thật
# ---------------------------------------------------------------------------

# Địa chỉ Kafka và công tắc bật/tắt toàn bộ phần Kafka (relay, topic)
# Local: localhost:9092. Aiven: kafka-xxx.aivencloud.com:port
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NVEST_KAFKA_ENABLED=true

# Kafka SSL / mTLS (BẮT BUỘC khi dùng Aiven Kafka).
# Hỗ trợ cả chuỗi Base64 (khuyến nghị cho Render) hoặc chuỗi PEM gốc.
# Để tạo chuỗi Base64 trên máy tính:
#   Linux/macOS: base64 -w0 ca.pem
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem"))
# NVEST_KAFKA_SSL_CA_CERT=
# NVEST_KAFKA_SSL_CLIENT_CERT=
# NVEST_KAFKA_SSL_CLIENT_KEY=
# NVEST_KAFKA_SSL_KEY_PASSWORD=
# NVEST_KAFKA_SSL_ENDPOINT_ID_ALGO=https

# Khóa ký JWT, tối thiểu 32 byte. BẮT BUỘC set khi deploy thật.
# Sinh bằng: openssl rand -base64 48
# NVEST_JWT_SECRET=

# CHỈ đặt true khi chạy local. Nếu dùng khóa JWT mặc định mà không bật biến này,
# app sẽ từ chối khởi động.
# NVEST_ALLOW_DEV_JWT_SECRET=true

# Tài liệu OpenAPI/Swagger tại /swagger-ui và /v3/api-docs.
# Mặc định true cho dev. Khi deploy thật nên đặt false để không công khai API docs.
# NVEST_OPENAPI_ENABLED=false

# Giới hạn đăng nhập sai theo cặp (IP, email). Sai quá số lần trong khoảng thời gian
# thì trả 429 cho tới khi cửa sổ trôi qua. Mặc định: 5 lần / 15 phút.
# NVEST_LOGIN_RATE_LIMIT_ENABLED=true
# NVEST_LOGIN_RATE_LIMIT_MAX_FAILURES=5
# NVEST_LOGIN_RATE_LIMIT_WINDOW=PT15M

# Khóa HMAC ký webhook của cổng giả. Không set = dùng khóa mặc định trong mã nguồn
# (ai cũng biết, chỉ dùng cho dev). Khi deploy thật hãy set một khóa ngẫu nhiên.
# NVEST_MOCK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cổng thanh toán
# ---------------------------------------------------------------------------

# mock (dev/demo) hoặc vnpay (nạp qua VNPAY sandbox).
# VNPAY không có API chi tiền nên khi provider=vnpay, API rút tiền trả 501
# thay vì âm thầm dùng cổng giả.
NVEST_PAYMENT_PROVIDER=mock

# Địa chỉ công khai của ứng dụng, dùng để dựng checkoutUrl của cổng giả.
# Phải trỏ tới chính app này, ví dụ http://localhost:8080.
NVEST_CHECKOUT_BASE_URL=http://localhost:8080

# VNPAY sandbox (chỉ cần khi NVEST_PAYMENT_PROVIDER=vnpay).
# Lấy từ merchant portal VNPAY. KHÔNG commit giá trị thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Trang frontend hiển thị kết quả. CHỈ để hiển thị; tiền vào ví nhờ IPN và đối soát.
NVEST_VNPAY_RETURN_URL=http://localhost:3000/payment/result

# ---------------------------------------------------------------------------
# Email (xác thực email, quên mật khẩu, nhắc đáo hạn)
# ---------------------------------------------------------------------------

# false = LoggingEmailSender: nội dung mail được ghi ra log (chỉ dùng khi dev).
# true  = gửi thật, chọn transport bằng NVEST_MAIL_PROVIDER.
NVEST_MAIL_ENABLED=false
# smtp  = JavaMail: Mailpit/Gmail khi chạy local, hoặc server trả tiền.
# brevo = Brevo HTTP API qua port 443. Dùng cách này trên Render free vì
#         Render chặn outbound port 25/465/587 nên SMTP không gửi được.
NVEST_MAIL_PROVIDER=smtp
NVEST_MAIL_FROM=no-reply@nvest.local
NVEST_MAIL_FROM_NAME=Nvest Savings
NVEST_VERIFICATION_LINK=http://localhost:3000/verify-email?token=
NVEST_RESET_LINK=http://localhost:3000/reset-password?token=

# Cách 1 - Mailpit (không cần mật khẩu, xem mail tại http://localhost:8025):
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# Cách 2 - Gmail thật (chỉ dùng được ở local hoặc server trả tiền).
# Phải bật 2FA và tạo App Password (KHÔNG dùng mật khẩu Gmail).
# Bỏ dấu # ở các dòng dưới rồi điền giá trị thật vào .env (file này không commit).
# NVEST_MAIL_ENABLED=true
# NVEST_MAIL_PROVIDER=smtp
# NVEST_MAIL_FROM=you@gmail.com
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=app-password-16-ky-tu
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true

# Cách 3 - Brevo HTTP API (khuyên dùng khi deploy, kể cả Render free).
# Tạo API key tại https://app.brevo.com/settings/keys/api.
# NVEST_MAIL_FROM phải là email hoặc domain đã xác minh trong Brevo.
# NVEST_MAIL_ENABLED=true
# NVEST_MAIL_PROVIDER=brevo
# NVEST_MAIL_FROM=sender-da-xac-minh@your-domain.com
# BREVO_API_KEY=xkeysib-...

# Health check SMTP của /actuator/health. Để false khi dev và trên Render
# (healthCheckPath dùng /actuator/health; SMTP lỗi sẽ làm service bị restart).
# NVEST_MAIL_HEALTH_ENABLED=false

# Thời hạn token, định dạng ISO-8601. P24H KHÔNG hợp lệ; 24 giờ là PT24H.
NVEST_EMAIL_VERIFICATION_TTL=PT24H
NVEST_PASSWORD_RESET_TTL=PT30M
# Khoảng cách tối thiểu giữa hai lần gửi lại/quên mật khẩu của cùng user.
NVEST_EMAIL_TOKEN_COOLDOWN=PT60S

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Origin của frontend, cách nhau bởi dấu phẩy.
# Không set = dùng mặc định http://localhost:3000,http://localhost:5173.
# Set rỗng = không cho origin nào. Khi deploy thật hãy đổi sang domain frontend.
NVEST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Tùy chọn (đã có giá trị mặc định trong application.yml)
# ---------------------------------------------------------------------------

# Thời hạn JWT, định dạng ISO-8601.
NVEST_JWT_TTL=PT1H

# Thời hạn tuyệt đối của refresh token, định dạng ISO-8601. Không trượt khi refresh:
# token mới luôn giữ expires_at của token đầu tiên trong cùng phiên.
NVEST_REFRESH_TOKEN_TTL=P30D

# Lịch chạy job (cron 6 trường, giờ Việt Nam).
# NVEST_JOBS_MATURITY_CRON=0 5 0 * * *
# NVEST_JOBS_ACCRUAL_CRON=0 5 0 * * *
# Nhắc đáo hạn: chạy 00:10, nhắc khi còn 3 ngày và còn 1 ngày.
# NVEST_JOBS_MATURITY_REMINDER_CRON=0 10 0 * * *
# NVEST_JOBS_RECONCILIATION_CRON=0 */5 * * * *
# Dọn token xác thực/reset đã hết hạn quá 30 ngày.
# NVEST_JOBS_USER_TOKEN_CLEANUP_CRON=0 30 3 * * *

# Kết nối DB (mặc định khớp docker-compose.yml).
# Khi deploy với Neon PostgreSQL:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/savings?sslmode=require
#   SPRING_DATASOURCE_USERNAME=savings_owner
#   SPRING_DATASOURCE_PASSWORD=your_neon_password
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/savings
# SPRING_DATASOURCE_USERNAME=savings
# SPRING_DATASOURCE_PASSWORD=savings

# Cấu hình connection pool HikariCP (tối ưu cho Neon serverless & Render free tier)
# SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MIN_IDLE=2
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
